NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/emr_appointments

# Generate strong secrets for real deployments, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Comma separated list of allowed browser origins (REST + Socket.IO)
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
# Set to the number of reverse proxies in front of the API (e.g. 1) so req.ip / rate limiting are correct
TRUST_PROXY=0
BODY_LIMIT=100kb

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
